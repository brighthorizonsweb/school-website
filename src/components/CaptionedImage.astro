---
import type { CaptionedImage } from '../lib/types';
import { optimizedImageUrl } from '../lib/sanityImage';

interface Props {
	image: CaptionedImage;
	class?: string;
	variant?: 'card' | 'article';
}

const { image, class: className = '', variant = 'card' } = Astro.props;

const dims = image.asset?.metadata?.dimensions;
const src = image.asset?._id
	? optimizedImageUrl(
			{ _ref: image.asset._id },
			variant === 'article'
				? { width: 800, height: 800, fit: 'max' }
				: { width: 800 },
		)
	: image.asset?.url;

const imgClass =
	variant === 'article'
		? 'mx-auto h-auto max-h-[22rem] w-auto max-w-full object-contain sm:max-h-[28rem]'
		: 'h-full w-full object-cover';

const figureClass =
	variant === 'article'
		? `mx-auto w-fit max-w-xl overflow-hidden rounded-xl ${className}`
		: `overflow-hidden rounded-xl bg-stone-100 ${className}`;
---

{
	src && (
		<figure class={figureClass}>
			<img
				src={src}
				alt={image.alt}
				width={dims?.width}
				height={dims?.height}
				class={imgClass}
				loading="lazy"
			/>
			{image.caption && (
				<figcaption class="px-3 py-2 text-center text-sm text-slate-600">{image.caption}</figcaption>
			)}
		</figure>
	)
}
